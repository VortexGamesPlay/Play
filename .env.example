# Copier en .env.local et compléter (ne jamais committer les vraies valeurs).
# Projet Supabase (clé « anon » publique uniquement — la clé « service » reste sur le serveur).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Identifiant client PayPal (public). Le « secret » PayPal reste dans les secrets des fonctions serveur.
VITE_PAYPAL_CLIENT_ID=
# sandbox (par défaut) ou live
VITE_PAYPAL_ENV=sandbox
# 1 = active le mode test (faux argent) dans un build de production (préversion uniquement)
VITE_PAYMENTS_TEST=
