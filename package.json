{
  "name": "eggverse",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "EGGVERSE — Le monde des créatures oubliées",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "vitest run src/data",
    "smoke": "node scripts/smoke.mjs",
    "showcase-save": "vite-node scripts/make-showcase-save.ts"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.7.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
